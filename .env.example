# The project runs in demo mode without any secrets.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Optional Canvas OAuth integration.
# Ask your institution's Canvas administrator for an approved developer key.
CANVAS_BASE_URL=https://canvas.example.edu
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:3000/auth/canvas/callback

# Optional Anthropic integration. Leave AI_PROVIDER=demo for local responses.
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
AI_MODEL=
